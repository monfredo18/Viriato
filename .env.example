# Copie para .env e ajuste. NUNCA versione o .env.
DB_USER=viriato
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root
JWT_SECRET=gere-com-openssl-rand-base64-48
# Produção: use IAM Role (ECS/EC2) e deixe S3_ACCESS_KEY/S3_SECRET_KEY vazios.
S3_BUCKET=viriato-documentos
S3_REGIAO=sa-east-1
# Primeiro administrador (criado só quando o banco está vazio; ele troca a senha no primeiro acesso).
ADMIN_NOME=Administrador
ADMIN_SENHA=defina-uma-senha-inicial
ADMIN_EMPRESA=Nome da sua empresa

# E-mail. O jeito mais simples: o administrador configura o servidor na tela (Cadastros → E-mail).
# As variáveis abaixo definem só o servidor PADRÃO; sem elas, o Docker local usa o Mailpit (http://localhost:8025),
# que só CAPTURA os e-mails. Exemplo de servidor padrão (porta 587 e STARTTLS):
# MAIL_HOST=smtp.seudominio.com
# MAIL_PORT=587
# MAIL_USER=usuario-smtp
# MAIL_PASSWORD=senha-ou-senha-de-aplicativo
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_REMETENTE=avisos@seudominio.com   # muitos provedores só aceitam remetente do próprio domínio/conta
